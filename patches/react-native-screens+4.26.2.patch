+#pragma mark - Tab bar visibility
+
+- (void)setTabBarHidden:(BOOL)hidden animated:(BOOL)animated
+{
+  if (!animated) {
+    [super setTabBarHidden:hidden animated:NO];
+    self.tabBar.transform = CGAffineTransformIdentity;
+    _tabBarHiddenByCustomTransition = hidden;
+    return;
+  }
+
+  const NSUInteger animationToken = ++_tabBarVisibilityAnimationToken;
+  const CGFloat hiddenOffset = CGRectGetHeight(self.tabBar.bounds) + self.view.safeAreaInsets.bottom;
+  const NSTimeInterval duration = hidden ? 0.24 : 0.28;
+  const UIViewAnimationOptions options = UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionCurveEaseOut;
+
+  if (!hidden && _tabBarHiddenByCustomTransition) {
+    [super setTabBarHidden:NO animated:NO];
+    self.tabBar.transform = CGAffineTransformMakeTranslation(0, hiddenOffset);
+    _tabBarHiddenByCustomTransition = NO;
+  }
+
+  [UIView animateWithDuration:duration
+                        delay:0
+                      options:options
+                   animations:^{
+                     self.tabBar.transform = hidden ? CGAffineTransformMakeTranslation(0, hiddenOffset)
+                                                        : CGAffineTransformIdentity;
+                   }
+                   completion:^(BOOL finished) {
+                     if (!hidden || !finished || animationToken != self->_tabBarVisibilityAnimationToken) {
+                       return;
+                     }
+
+                     [super setTabBarHidden:YES animated:NO];
+                     self.tabBar.transform = CGAffineTransformIdentity;
+                     self->_tabBarHiddenByCustomTransition = YES;
+                   }];
+}
