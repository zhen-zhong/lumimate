{
  "expo": {
    "name": "lumimate",
    "slug": "lumimate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lumimate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.zhenzhong.lumimate"
    },
    "android": {
      "package": "com.zhenzhong.lumimate",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "允许 LumiMate 使用麦克风，用于发送语音消息。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 LumiMate 访问照片，用于发送图片。",
          "cameraPermission": "允许 LumiMate 使用相机，用于拍摄并发送照片。",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许 LumiMate 使用当前位置，用于在聊天中发送位置。"
        }
      ],
      [
        "expo-gaode-map",
        {
          "androidKey": "your-android-key",
          "iosKey": "e64c7d8eccee23ff895be20ac480c916",
          "enableLocation": true,
          "locationDescription": "允许 LumiMate 使用当前位置，用于展示地图和位置服务。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c7c82494-9779-4cec-97e3-a65dd1d485c4"
      }
    },
    "owner": "zhen-zhong"
  }
}
